# ============================================================
# Agente CIAR v2 — copia este archivo a .env y completa secretos
# ============================================================

# OpenAI is the only supported provider. Each role may use a different model.
OPENAI_API_KEY=

# Conversational roles: routing, Cypher generation, and all public answers.
OPENAI_MODEL_ORQUESTADOR=gpt-oss-120b
OPENAI_MODEL_GENERADOR_CYPHER=gpt-5.6-luna
OPENAI_REASONING_EFFORT_GENERADOR_CYPHER=max
OPENAI_MODEL_ANALISTA=gpt-oss-20b

# Responses API is enabled by default for all three roles.
# Set a role override to false only for a compatible chat endpoint.
# OPENAI_USE_RESPONSES_API_ORQUESTADOR=false
# OPENAI_USE_RESPONSES_API_GENERADOR_CYPHER=false
# OPENAI_USE_RESPONSES_API_ANALISTA=false

# Optional OpenAI-compatible endpoint.
# OPENAI_BASE_URL=
LLM_TEMPERATURE=0

# Normalizadores de empleabilidad y sílabos.
# Usa el catálogo CHH externo en ejecuciones reales; las pruebas configuran su
# propio catálogo aislado y desactivan el LLM explícitamente.
NORMALIZADOR_DATA_DIR=.normalizador
NORMALIZADOR_CATALOGOS_DIR=
NORMALIZADOR_CURRICULAR_LLM=true
NORMALIZADOR_CURRICULAR_INSPECTOR=true
NORMALIZADOR_CURRICULAR_ESCALAR_RESIDUALES=false
OPENAI_MODEL_CURRICULAR=gpt-5.6-luna
OPENAI_MODEL_INSPECTOR_CURRICULAR=
OPENAI_MODEL_CURRICULAR_RESIDUAL=gpt-5.6-terra
OPENAI_MODEL_INSPECTOR_CURRICULAR_RESIDUAL=gpt-5.6-terra
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# Optional scoped semantic retrieval for the curricular normalizer. It is disabled
# unless both switches are explicit and the normalized career@period pair is in the allowlist.
# Bare career entries and entries with an invalid period fail closed.
# Keep this list restricted to careers with a reviewed catalog for the requested period.
NORMALIZADOR_CURRICULAR_EMBEDDINGS=false
NORMALIZADOR_CURRICULAR_EMBEDDING_CARRERAS=
# Embedding model used only by the curricular retriever. Requires OPENAI_API_KEY.
NORMALIZADOR_EMBEDDING_MODEL=text-embedding-3-small
# Candidates must score strictly above this value; 0 rejects zero and negative scores.
# Allowed range: 0 <= value < 1. Raise it only after retrieval-quality review.
NORMALIZADOR_CURRICULAR_EMBEDDING_MIN_SIMILARITY=0

# Extractor curricular Cactus/ULima. Las credenciales se envían por ejecución desde la UI;
# nunca se configuran ni se persisten en este archivo.
NORMALIZADOR_CACTUS_HEADLESS=false
NORMALIZADOR_CACTUS_DOWNLOAD_WORKERS=3

# Detailed local development traces. Keep false outside explicit debugging sessions.
# Traces include exact Cypher/parameters and final answers, but redact identities,
# credentials, tokens, auth headers, and bound result previews.

# Neo4j: domain sessions are opened explicitly with READ_ACCESS.
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_SCHEMA_CACHE_TTL_SECONDS=900

# Domain queries: use a Neo4j principal with read-only permissions.
# If absent, NEO4J_* is used as a whole-group fallback; READ routing does not replace database permissions.
NEO4J_READ_URI=
NEO4J_READ_USER=
NEO4J_READ_PASSWORD=
NEO4J_READ_DATABASE=neo4j
NEO4J_READ_QUERY_TIMEOUT_SECONDS=10

# Offline/admin graph ingestion only. Never reuse the domain read credentials.
NEO4J_INGEST_URI=
NEO4J_INGEST_USER=
NEO4J_INGEST_PASSWORD=
NEO4J_INGEST_DATABASE=neo4j
OPENAI_MODEL_INGESTION=gpt-4o-mini

# Process-local query-result cache.
QUERY_RESULT_CACHE_TTL_SECONDS=600
QUERY_RESULT_CACHE_MAX_ENTRIES=256

# Grounded public answers pass a local bounded-output validator; no inspector model is used.

# INFO muestra decisiones y cambios de estado; DEBUG agrega una linea por funcion finalizada.
# JSON conserva los mismos campos para enviarlos a un colector de observabilidad.
LOG_FORMATO=legible
LOG_NIVEL=INFO
LOG_FUNCIONES=true
LOG_MAX_CHARS_CAMPO=800
# false correlaciona mediante un hash y evita publicar el id de sesion original.
LOG_SESION_COMPLETA=false

# LangSmith automatically observes ChatOpenAI calls when tracing is enabled.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ciar-agente-v2
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Structured backend log threshold: DEBUG, INFO, WARNING, ERROR, or CRITICAL.
CIAR_LOG_LEVEL=INFO
# Keep JSON for collectors. Use ``human`` together with CIAR_LOG_SCOPE=nodes
# during a local diagnosis to print one START/END block with numbered nodes.
CIAR_LOG_FORMAT=json
# Use ``nodes`` during a local diagnosis to hide API/LLM/Neo4j detail events and
# keep only graph node boundaries. ``node_started`` carries the input snapshot;
# ``node_completed``/``node_failed`` carry the output or error snapshot.
CIAR_LOG_SCOPE=all
# Exact, bounded state previews are opt-in. Keep disabled outside a local debug run.
CIAR_NODE_LOG_VALUES=0
