<mxfile host="app.diagrams.net" modified="2026-09-25T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="flujo-agente" name="Flujo del agente">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Flujo del agente de empleabilidad" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#173F41;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="650" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="El agente responde preguntas generales o consulta datos de Neo4j de manera segura." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#4D6263;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="780" height="30" as="geometry"/></mxCell>

        <mxCell id="start" value="Pregunta de la persona&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Escrita en lenguaje cotidiano&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FBFA;strokeColor=#245A5C;fontColor=#173F41;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="45" y="145" width="190" height="82" as="geometry"/></mxCell>
        <mxCell id="input" value="Validar pregunta&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Comprueba que tenga contenido y formato válido&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF7F4;strokeColor=#3F7C68;fontColor=#173F41;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="145" width="210" height="82" as="geometry"/></mxCell>
        <mxCell id="injection" value="Proteger la conversación&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Detecta instrucciones que intentan alterar al agente&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF7F4;strokeColor=#3F7C68;fontColor=#173F41;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="555" y="145" width="220" height="82" as="geometry"/></mxCell>
        <mxCell id="orchestrator" value="Entender la intención&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Un modelo decide qué tipo de respuesta requiere&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FBFA;strokeColor=#245A5C;fontColor=#173F41;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="830" y="145" width="220" height="82" as="geometry"/></mxCell>

        <mxCell id="decision" value="¿Necesita datos del grafo?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#245A5C;fontColor=#173F41;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="895" y="285" width="140" height="90" as="geometry"/></mxCell>
        <mxCell id="direct" value="Respuesta directa&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Responde preguntas generales sin consultar Neo4j&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F4FB;strokeColor=#77639A;fontColor=#173F41;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="290" width="220" height="82" as="geometry"/></mxCell>

        <mxCell id="schema" value="Leer estructura de datos&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Consulta qué información y relaciones están disponibles&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FBFA;strokeColor=#245A5C;fontColor=#173F41;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="865" y="435" width="200" height="82" as="geometry"/></mxCell>
        <mxCell id="cypher" value="Preparar consulta&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Un modelo transforma la pregunta en una consulta de datos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FBFA;strokeColor=#245A5C;fontColor=#173F41;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="865" y="555" width="200" height="82" as="geometry"/></mxCell>
        <mxCell id="entity" value="Resolver entidades&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Relaciona nombres escritos por la persona con empresas, carreras o competencias del grafo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FBFA;strokeColor=#245A5C;fontColor=#173F41;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="585" y="675" width="250" height="96" as="geometry"/></mxCell>
        <mxCell id="guard" value="Confirmar seguridad&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Valida entidades, estructura y que la consulta solo lea datos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF7F4;strokeColor=#3F7C68;fontColor=#173F41;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="875" y="690" width="220" height="82" as="geometry"/></mxCell>
        <mxCell id="neo4j" value="Consultar Neo4j&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Ejecuta únicamente la consulta validada&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF7F4;strokeColor=#3F7C68;fontColor=#173F41;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1145" y="690" width="190" height="82" as="geometry"/></mxCell>
        <mxCell id="write" value="Redactar respuesta&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Un modelo explica los resultados de forma clara y útil&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F4FB;strokeColor=#77639A;fontColor=#173F41;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1145" y="835" width="220" height="82" as="geometry"/></mxCell>
        <mxCell id="memory" value="Guardar contexto breve&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Conserva lo necesario para continuar la conversación&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FBFA;strokeColor=#245A5C;fontColor=#173F41;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="835" width="230" height="82" as="geometry"/></mxCell>
        <mxCell id="end" value="Respuesta para la persona" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF7F4;strokeColor=#3F7C68;fontColor=#173F41;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="835" width="230" height="82" as="geometry"/></mxCell>
        <mxCell id="safe" value="Respuesta segura&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Si algo no es válido o no se puede consultar, lo informa sin ejecutar acciones riesgosas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6F3;strokeColor=#B6614D;fontColor=#173F41;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="45" y="475" width="270" height="90" as="geometry"/></mxCell>

        <mxCell id="e1" edge="1" parent="1" source="start" target="input" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#5A9293;strokeWidth=2;"/><mxCell id="e2" edge="1" parent="1" source="input" target="injection" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#5A9293;strokeWidth=2;"/><mxCell id="e3" edge="1" parent="1" source="injection" target="orchestrator" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#5A9293;strokeWidth=2;"/><mxCell id="e4" edge="1" parent="1" source="orchestrator" target="decision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#5A9293;strokeWidth=2;"/>
        <mxCell id="e5" value="No" edge="1" parent="1" source="decision" target="direct" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#5A9293;strokeWidth=2;fontColor=#3F7C68;fontStyle=1;"/><mxCell id="e6" value="Sí" edge="1" parent="1" source="decision" target="schema" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#5A9293;strokeWidth=2;fontColor=#3F7C68;fontStyle=1;"/><mxCell id="e7" edge="1" parent="1" source="schema" target="cypher" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#5A9293;strokeWidth=2;"/><mxCell id="e8" edge="1" parent="1" source="cypher" target="entity" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#5A9293;strokeWidth=2;"/><mxCell id="e9" edge="1" parent="1" source="entity" target="guard" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#5A9293;strokeWidth=2;"/><mxCell id="e10" edge="1" parent="1" source="guard" target="neo4j" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#5A9293;strokeWidth=2;"/><mxCell id="e11" edge="1" parent="1" source="neo4j" target="write" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#5A9293;strokeWidth=2;"/><mxCell id="e12" edge="1" parent="1" source="write" target="memory" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#5A9293;strokeWidth=2;"/><mxCell id="e13" edge="1" parent="1" source="direct" target="memory" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#5A9293;strokeWidth=2;"/><mxCell id="e14" edge="1" parent="1" source="memory" target="end" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#5A9293;strokeWidth=2;"/>
        <mxCell id="e15" value="Entrada o consulta no válida" edge="1" parent="1" source="input" target="safe" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#B6614D;fontColor=#B6614D;fontSize=12;"/><mxCell id="e16" edge="1" parent="1" source="safe" target="memory" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#B6614D;"/>
      </root>
