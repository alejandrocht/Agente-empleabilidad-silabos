<mxfile host="app.diagrams.net" modified="2026-09-25T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="flujo-normalizador-empleabilidad" name="Normalizador de empleabilidad">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Flujo del normalizador de empleabilidad" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#173F41;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="700" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Convierte publicaciones de empleo en información consistente para validar y cargar en Neo4j." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#4D6263;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="820" height="30" as="geometry"/></mxCell>

        <mxCell id="upload" value="Subir Excel&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;La persona selecciona la hoja con publicaciones&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FBFA;strokeColor=#245A5C;fontColor=#173F41;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="145" width="200" height="82" as="geometry"/></mxCell>
        <mxCell id="clean" value="Limpieza&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Quita texto que no aporta y ordena las viñetas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FBFA;strokeColor=#245A5C;fontColor=#173F41;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="145" width="210" height="82" as="geometry"/></mxCell>
        <mxCell id="careers" value="Reconocer carreras&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Relaciona la carrera indicada con las carreras de referencia&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FBFA;strokeColor=#245A5C;fontColor=#173F41;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="550" y="145" width="225" height="82" as="geometry"/></mxCell>
        <mxCell id="prepare" value="Preparar publicación&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Conserva funciones, puesto y carreras reconocidas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FBFA;strokeColor=#245A5C;fontColor=#173F41;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="825" y="145" width="225" height="82" as="geometry"/></mxCell>

        <mxCell id="catalog" value="Catálogo oficial&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Competencias técnicas permitidas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF8EE;strokeColor=#897439;fontColor=#173F41;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="335" width="240" height="82" as="geometry"/></mxCell>
        <mxCell id="extract" value="Identificar competencias&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;El modelo revisa las funciones y prioriza opciones ligadas a la carrera&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FBFA;strokeColor=#245A5C;fontColor=#173F41;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="570" y="335" width="300" height="95" as="geometry"/></mxCell>
        <mxCell id="retry" value="Si la extracción falla&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Se realizan hasta 2 reintentos. Si persiste, la publicación pasa a cuarentena.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6F3;strokeColor=#B6614D;fontColor=#98503F;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="920" y="335" width="250" height="95" as="geometry"/></mxCell>

        <mxCell id="valid" value="¿Se encontró una competencia válida?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#245A5C;fontColor=#173F41;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="495" width="145" height="95" as="geometry"/></mxCell>
        <mxCell id="quarantine" value="Publicación separada&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Se registra en cuarentena y no se carga en Neo4j&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6F3;strokeColor=#B6614D;fontColor=#173F41;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="165" y="505" width="300" height="82" as="geometry"/></mxCell>

        <mxCell id="package" value="Preparar carga&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Crea publicaciones, puestos y competencias relacionadas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF7F4;strokeColor=#3F7C68;fontColor=#173F41;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="610" y="665" width="260" height="82" as="geometry"/></mxCell>
        <mxCell id="validate" value="Validar carga&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Revisa formato, referencias y si cada fila es nueva&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FBFA;strokeColor=#245A5C;fontColor=#173F41;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="930" y="665" width="220" height="82" as="geometry"/></mxCell>
        <mxCell id="neo4j" value="Neo4j sin duplicados&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Carga confirmada de datos nuevos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF7F4;strokeColor=#3F7C68;fontColor=#173F41;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="905" y="815" width="260" height="75" as="geometry"/></mxCell>

        <mxCell id="e1" edge="1" parent="1" source="upload" target="clean" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#5A9293;strokeWidth=2;"/><mxCell id="e2" edge="1" parent="1" source="clean" target="careers" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#5A9293;strokeWidth=2;"/><mxCell id="e3" edge="1" parent="1" source="careers" target="prepare" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#5A9293;strokeWidth=2;"/><mxCell id="e4" edge="1" parent="1" source="prepare" target="extract" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#5A9293;strokeWidth=2;"/>
        <mxCell id="e5" edge="1" parent="1" source="catalog" target="extract" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#9A8240;strokeWidth=2;"/><mxCell id="e6" value="Si falla" edge="1" parent="1" source="extract" target="retry" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#B6614D;fontColor=#B6614D;fontSize=12;"/><mxCell id="e7" value="Resultado" edge="1" parent="1" source="extract" target="valid" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#5A9293;strokeWidth=2;fontColor=#3F7C68;fontSize=12;"/>
        <mxCell id="e8" value="No" edge="1" parent="1" source="valid" target="quarantine" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#B6614D;fontColor=#B6614D;fontSize=12;"/><mxCell id="e9" value="Sí" edge="1" parent="1" source="valid" target="package" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#5A9293;fontColor=#3F7C68;fontSize=12;"/><mxCell id="e10" edge="1" parent="1" source="package" target="validate" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#5A9293;strokeWidth=2;"/><mxCell id="e11" edge="1" parent="1" source="validate" target="neo4j" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#5A9293;strokeWidth=2;"/>
      </root>
    </mxGraphModel>
  </diagram>
